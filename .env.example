# Copy to .env and fill in locally. Never commit .env or real credentials.
# Placeholder values (PASTE_*_HERE, empty) are ignored by the provisioning scripts.
#
# Resolution order: environment variables first, then AWS Secrets Manager
# secret "grafana-alerts/provisioning" (keys: webhook_url, read_token, write_token).

GRAFANA_URL=https://grafana.example.com
GRAFANA_TEAMS_WEBHOOK_URL=PASTE_WEBHOOK_URL_HERE
GRAFANA_READ_TOKEN=PASTE_READ_TOKEN_HERE
GRAFANA_WRITE_TOKEN=PASTE_WRITE_TOKEN_HERE
